# Sao chép file này thành .env rồi điền giá trị. File .env KHÔNG được đưa lên Git.

# --- Supabase (bỏ trống 2 dòng dưới = lưu file trong thư mục data/ như cũ) ---
# Supabase Dashboard → Project Settings → API (hoặc Data API):
#   SUPABASE_URL: "Project URL", dạng https://abcdxyz.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY: khoá "service_role" (bí mật — chỉ đặt ở server, không đưa vào trình duyệt)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket Storage cho ảnh (tạo sẵn trong supabase/schema.sql)
SUPABASE_BUCKET=tuongky

# --- Trang quản trị ---
# Đặt mật khẩu trước khi đưa lên mạng (bỏ trống = không cần mật khẩu)
ADMIN_PASSWORD=
